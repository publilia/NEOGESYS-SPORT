{
	"name": "@neogesys/sport",
	"private": true,
	"version": "2026.4.1",
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"format": "biome format --write .",
		"test": "turbo test",
		"typecheck": "turbo typecheck",
		"db:generate": "turbo db:generate --filter=@neogesys/db",
		"db:migrate": "turbo db:migrate --filter=@neogesys/db",
		"db:push": "turbo db:push --filter=@neogesys/db",
		"db:seed": "turbo db:seed --filter=@neogesys/db",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:calver": "node scripts/release.mjs calver",
		"release:dry": "node scripts/release.mjs patch --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@tailwindcss/postcss": "^4.2.2",
		"turbo": "^2.3.3",
		"typescript": "^5.7.3"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "^18.3.18",
			"@types/react-dom": "^18.3.5"
		}
	}
}
