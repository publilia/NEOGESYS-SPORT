{
	"type": "module",
	"name": "@neogesys/db",
	"version": "0.1.0",
	"private": true,
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "tsx src/seed/index.ts",
		"db:studio": "drizzle-kit studio",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.38.3",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@neogesys/tsconfig": "workspace:*",
		"@types/node": "^22.10.5",
		"drizzle-kit": "^0.30.4",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	}
}
